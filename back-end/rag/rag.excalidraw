    {
      "id": "5AOks5h9cT9-XoYudhGto",
      "type": "text",
      "x": -4332.779027969122,
      "y": 4793.643735123057,
      "width": 640.87939453125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4V",
      "roundness": null,
      "seed": 1987461784,
      "version": 250,
      "versionNonce": 104165352,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791558050806,
      "link": null,
      "locked": false,
      "text": "For each question, in rank order, build MinimalSource from each\ndict. This validates the shapes at the stage boundary. Ranking\nmatters because recall@1, @3 and @5 all depend on order. The\nreturn value is one list of sources per question, aligned with the\ninput order.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For each question, in rank order, build MinimalSource from each dict. This validates the shapes at the stage boundary. Ranking matters because recall@1, @3 and @5 all depend on order. The return value is one list of sources per question, aligned with the input order.",
      "autoResize": false,
      "lineHeight": 1.25
    },
