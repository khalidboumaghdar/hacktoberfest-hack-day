      "link": null,
      "locked": false,
      "text": "-processed_data: List[Dict] = []: Stores metadata dicts containing file \npath and character range bounds.\n\n-list_of_chunks: List[str] = []: Stores raw string content for every\n chunk generated.",
      "fontSize": 19.824580478549525,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-processed_data: List[Dict] = []: Stores metadata dicts containing file \npath and character range bounds.\n\n-list_of_chunks: List[str] = []: Stores raw string content for every\n chunk generated.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fG-KscWR3OGY4dL49Fyea",
      "type": "text",
      "x": 798.2452619994565,
      "y": -2269.3389123604784,
      "width": 822.8112182617188,
      "height": 298.61428212941485,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
