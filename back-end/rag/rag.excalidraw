      "isDeleted": false,
      "boundElements": [
        {
          "id": "j47DFQXgt1UVtw0ZTiDzC",
          "type": "arrow"
        }
      ],
      "updated": 1791558050806,
      "link": null,
      "locked": false,
      "text": "-@abstractmethod def chunk(self, path: Path, max_chunk_size: int = 2000) -> None:\nContract method to be implemented by child classes for file splitting.\n-_format_data(self, path: Path, chunks: list) -> None:\n Extracts start/end character indices from split chunk metadata and passes\n them to update_data().\n-@classmethod get_processed_data(cls) -> List[Dict]: \nReturns the accumulated list of positional metadata dictionaries.\n-@classmethod get_list_of_chunks(cls) -> List[Dict]: \nReturns the accumulated list of raw text chunks.\n-@classmethod update_data(cls, data: Dict[str, Any], content: str) -> None: \nAppends new chunk metadata to cls.processed_data and raw content\n to cls.list_of_chunks.",
      "fontSize": 19.907618808627653,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-@abstractmethod def chunk(self, path: Path, max_chunk_size: int = 2000) -> None:\nContract method to be implemented by child classes for file splitting.\n-_format_data(self, path: Path, chunks: list) -> None:\n Extracts start/end character indices from split chunk metadata and passes\n them to update_data().\n-@classmethod get_processed_data(cls) -> List[Dict]: \nReturns the accumulated list of positional metadata dictionaries.\n-@classmethod get_list_of_chunks(cls) -> List[Dict]: \nReturns the accumulated list of raw text chunks.\n-@classmethod update_data(cls, data: Dict[str, Any], content: str) -> None: \nAppends new chunk metadata to cls.processed_data and raw content\n to cls.list_of_chunks.",
      "autoResize": true,
      "lineHeight": 1.25
    },
