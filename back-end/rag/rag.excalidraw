    {
      "id": "SFcJAzVSJAKtnpVsPQON_",
      "type": "text",
      "x": 8496.62720011152,
      "y": 6929.770295012565,
      "width": 518.7529907226562,
      "height": 340,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
