    {
      "id": "2mW_qgAKuoCkGfmCsn12K",
      "type": "text",
      "x": 7760.770949288017,
      "y": 6799.229912786965,
      "width": 542.1611328125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
