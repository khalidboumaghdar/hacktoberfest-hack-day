      "boundElements": [],
      "updated": 1791639008804,
      "link": null,
      "locked": false,
      "text": "Truth sources unordered, results ranked\nNo positional pairing\nChecking only the first chunk is a bug",
      "fontSize": 29.77016520631906,
      "fontFamily": 5,
      "textAlign": "center",
