      "isDeleted": false,
      "boundElements": [],
      "updated": 1791558050806,
      "link": null,
      "locked": false,
      "text": "-__init__(root_dir: Union[str, Path]): Converts the directory path into\n a Path instance and initializes files_by_extensio\n-scan() -> Tuple[Dict[str, int], Dict[str, List[Path]]]:\n    -Traverses self.root_dir recursively using Path.rglob(\"*\").\n    -Counts total files scanned (files_count) and total supported\n     target files (chunked_files).\n    -Groups matching target file paths into self.files_by_extension.\n    -Returns a tuple containing metadata counts and the categorized path\n    dictionary.",
      "fontSize": 19.824580478549525,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-__init__(root_dir: Union[str, Path]): Converts the directory path into\n a Path instance and initializes files_by_extensio\n-scan() -> Tuple[Dict[str, int], Dict[str, List[Path]]]:\n    -Traverses self.root_dir recursively using Path.rglob(\"*\").\n    -Counts total files scanned (files_count) and total supported\n     target files (chunked_files).\n    -Groups matching target file paths into self.files_by_extension.\n    -Returns a tuple containing metadata counts and the categorized path\n    dictionary.",
      "autoResize": true,
      "lineHeight": 1.25
    },
