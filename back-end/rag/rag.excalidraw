      "isDeleted": false,
      "boundElements": [],
      "updated": 1791639008804,
      "link": null,
      "locked": false,
      "text": "Results must be in rank order\nk above the retrieved count: warn, still compute\n1 source per question still needs @3, @5, @10",
      "fontSize": 29.77016520631906,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r9cIlAvaZcN6a_mJIsSVu",
      "originalText": "Results must be in rank order\nk above the retrieved count: warn, still compute\n1 source per question still needs @3, @5, @10",
