    },
    {
      "id": "XKxP8_Y8M048bC48UegzS",
      "type": "text",
      "x": 7768.053802429693,
      "y": 7343.921003209102,
      "width": 644.2568969726562,
      "height": 402.51408613457517,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA0",
      "roundness": null,
      "seed": 1560261528,
      "version": 190,
      "versionNonce": 1680690287,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791639008805,
      "link": null,
      "locked": false,
      "text": "Old vs new Evaluator. The right card is the\none to keep, and the left card is outdated.\nThe old card kept a temporary switch for\ntruth questions the student never answered.\nThe moulinette showed they count as recall\n0, so the switch is gone and the average\nruns over all truth questions. The old card\nalso skipped student ids that are absent\nfrom the truth file, but the moulinette\ncrashes (KeyError) on them, so the new card\nreports a clean error.",
      "fontSize": 29.273751718878195,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Old vs new Evaluator. The right card is the one to keep, and the left card is outdated. The old card kept a temporary switch for truth questions the student never answered. The moulinette showed they count as recall 0, so the switch is gone and the average runs over all truth questions. The old card also skipped student ids that are absent from the truth file, but the moulinette crashes (KeyError) on them, so the new card reports a clean error.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "TzhnChnYAbZx4_aF_F1E1",
      "type": "text",
      "x": 8520.836341410217,
      "y": 7358.492483522591,
      "width": 626.6927650565301,
      "height": 365.92189648597747,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA1",
      "roundness": null,
      "seed": 519405720,
      "version": 227,
      "versionNonce": 1086842511,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791639008805,
      "link": null,
      "locked": false,
      "text": "The new card also adds a check on the k\nstored in the student file, while accepting\nthat this k can be lower than the real\nnumber of sources. For that reason the “k\nabove data” warning now uses the real\nretrieved count instead of the stored k.\nThe k checks are inferred from two\nmoulinette runs, and the unknown-id error is\nmy design choice, not a copy of the\nmoulinette.",
      "fontSize": 29.2737517188782,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The new card also adds a check on the k stored in the student file, while accepting that this k can be lower than the real number of sources. For that reason the “k above data” warning now uses the real retrieved count instead of the stored k. The k checks are inferred from two moulinette runs, and the unknown-id error is my design choice, not a copy of the moulinette.",
      "autoResize": false,
      "lineHeight": 1.25
    },
