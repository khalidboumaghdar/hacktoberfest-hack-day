      "updated": 1791639008805,
      "link": null,
      "locked": false,
      "text": "-matcher: SourceMatcher: composition, injected so tests can swap it\n-k_values: List[int]: cleaned (positive, unique, sorted)\n-max_context_length: int = 2000: same limit the moulinette checks",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-matcher: SourceMatcher: composition, injected so tests can swap it\n-k_values: List[int]: cleaned (positive, unique, sorted)\n-max_context_length: int = 2000: same limit the moulinette checks",
      "autoResize": true,
      "lineHeight": 1.25
    },
