      "isDeleted": false,
      "boundElements": [],
      "updated": 1791558050806,
      "link": null,
      "locked": false,
      "text": "-__init__(root_dir: Union[str, Path]):  initializes files_by_extensio\n-scan(root_dir) -> Tuple[Dict[str, int], Dict[str, List[Path]]]:\n    -Converts the directory path into a Path instance\n    -Traverses self.root_dir recursively using Path.rglob(\"*\").\n    -Counts total files scanned (files_count) and total supported\n     target files (chunked_files).\n    -Groups matching target file paths into self.files_by_extension.\n    -Returns a tuple containing metadata counts and the categorized path\n    dictionary.\n\n-read(file_name) -> Any:\n    \n     ",
      "fontSize": 19.824580478549525,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-__init__(root_dir: Union[str, Path]):  initializes files_by_extensio\n-scan(root_dir) -> Tuple[Dict[str, int], Dict[str, List[Path]]]:\n    -Converts the directory path into a Path instance\n    -Traverses self.root_dir recursively using Path.rglob(\"*\").\n    -Counts total files scanned (files_count) and total supported\n     target files (chunked_files).\n    -Groups matching target file paths into self.files_by_extension.\n    -Returns a tuple containing metadata counts and the categorized path\n    dictionary.\n\n-read(file_name) -> Any:\n    \n     ",
      "autoResize": true,
      "lineHeight": 1.25
    },
