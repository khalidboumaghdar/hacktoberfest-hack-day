      "versionNonce": 2132795800,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791558050806,
      "link": null,
      "locked": false,
      "text": "Also decide what a nonsensical query does. If none of its tokens\nexist in the vocabulary, scores are all zero and you may get\narbitrary chunks back. Choose a policy on purpose (return empty,\nor return whatever comes back) and test that it doesn't crash.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Also decide what a nonsensical query does. If none of its tokens exist in the vocabulary, scores are all zero and you may get arbitrary chunks back. Choose a policy on purpose (return empty, or return whatever comes back) and test that it doesn't crash.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "5K-_UXi9MHgGlP_FCRrvS",
      "type": "text",
      "x": -5918.560201675176,
      "y": 4810.221938960137,
      "width": 640.87939453125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4N",
      "roundness": null,
      "seed": 2112641688,
      "version": 164,
      "versionNonce": 1819976680,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791558050806,
      "link": null,
      "locked": false,
      "text": "Use the smaller of requested k and the number of chunks. Asking\nbm25s for more results than documents can fail.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use the smaller of requested k and the number of chunks. Asking bm25s for more results than documents can fail.",
      "autoResize": false,
      "lineHeight": 1.25
    },
