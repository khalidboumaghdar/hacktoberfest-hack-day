      "x": -10577.041862427246,
      "y": 4785.300231316355,
      "width": 607.5194091796875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3y",
      "roundness": null,
      "seed": 451220888,
      "version": 184,
      "versionNonce": 1472234904,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791558050806,
      "link": null,
      "locked": false,
      "text": "Retrieval assumes indexing has run and left three things in\ndata/processed/indexing/: the bm25s index files, corpus.jsonl\n(chunk text), and minimal_source.json (file path plus character\nrange per chunk).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Retrieval assumes indexing has run and left three things in data/processed/indexing/: the bm25s index files, corpus.jsonl (chunk text), and minimal_source.json (file path plus character range per chunk).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "bxbmF5tUV8xXs7pxWZDdR",
      "type": "text",
      "x": -10580.188575684082,
      "y": 4939.779921868113,
      "width": 594.6880187988281,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3z",
      "roundness": null,
      "seed": 2111742616,
      "version": 230,
      "versionNonce": 1722171368,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791558050806,
      "link": null,
      "locked": false,
      "text": "The invariant everything rests on is that position i means\nthe same chunk in all three. That holds only because\nupdate_data appends text and metadata together. If the\nfiles come from different indexing runs, retrieval silently\nreturns wrong locations and nothing crashes. You'll add a\nguard for this in step 5.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The invariant everything rests on is that position i means the same chunk in all three. That holds only because update_data appends text and metadata together. If the files come from different indexing runs, retrieval silently returns wrong locations and nothing crashes. You'll add a guard for this in step 5.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "UZJQpSW153yQm3kYhl2dn",
      "type": "text",
      "x": -10571.760173555409,
      "y": 5151.724326833469,
      "width": 574.759521484375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b40",
      "roundness": null,
      "seed": 1142853528,
      "version": 174,
      "versionNonce": 1842090648,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791558050806,
      "link": null,
      "locked": false,
      "text": "Also confirm the indexer / indexing name mismatch is fixed.\nOtherwise none of this exists on disk.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Also confirm the indexer / indexing name mismatch is fixed. Otherwise none of this exists on disk.",
      "autoResize": false,
      "lineHeight": 1.25
    },
