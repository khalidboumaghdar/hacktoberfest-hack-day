      "locked": false,
      "text": "Step 9: Turn dicts into MinimalSource",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 9: Turn dicts into MinimalSource",
