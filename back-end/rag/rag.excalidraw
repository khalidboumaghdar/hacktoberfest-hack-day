    {
      "id": "gd21qtyR01HZ1G4YN073b",
      "type": "text",
      "x": 4847.076061824006,
      "y": -2401.2282984921294,
      "width": 817.2296752929688,
      "height": 148.68435358912143,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1M",
      "roundness": null,
      "seed": 313719704,
      "version": 447,
      "versionNonce": 1909624975,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791632694958,
      "link": null,
      "locked": false,
      "text": "-indexing(self, list_of_chunks: List[str], processed_data) -> None:\n    -Tokenizes raw chunk strings using bm25s.tokenize(..., stopwords=\"english\").\n    -Instantiates bm25s.BM25() and builds the index over the tokenized corpus.\n    -Saves the compiled retriever index and corpus text to data/processed/indexing.\n    -Writes processed_data (chunk location metadata) \n    to data/processed/indexing/minimal_source.json.",
      "fontSize": 19.824580478549525,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-indexing(self, list_of_chunks: List[str], processed_data) -> None:\n    -Tokenizes raw chunk strings using bm25s.tokenize(..., stopwords=\"english\").\n    -Instantiates bm25s.BM25() and builds the index over the tokenized corpus.\n    -Saves the compiled retriever index and corpus text to data/processed/indexing.\n    -Writes processed_data (chunk location metadata) \n    to data/processed/indexing/minimal_source.json.",
      "autoResize": true,
      "lineHeight": 1.25
    },
