    {
      "id": "EqBHV2myOQ8lM7gZP5Rnh",
      "type": "text",
      "x": 10262.981711139435,
      "y": 5008.464004855945,
      "width": 448.10972608334816,
      "height": 399.8436927795409,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9f",
      "roundness": null,
      "seed": 164478369,
      "version": 258,
      "versionNonce": 937073853,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791890146555,
      "link": null,
      "locked": false,
      "text": "decides whether two\nsources match. It answers\none narrow question: does\nthis retrieved source cover\nthis ground-truth source?\nThat means the same\nfile_path and an IoU of at\nleast 0.05. It knows\nnothing about questions,\nfiles, k or averages.",
      "fontSize": 31.987495422363267,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "decides whether two sources match. It answers one narrow question: does this retrieved source cover this ground-truth source? That means the same file_path and an IoU of at least 0.05. It knows nothing about questions, files, k or averages.",
      "autoResize": false,
      "lineHeight": 1.25
    },
