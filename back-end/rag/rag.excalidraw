      "updated": 1791637460428,
      "link": null,
      "locked": false,
      "text": "-student_valid: bool: result of validate_student\n-validation_errors: List[str]: why the student file is invalid\n-student_questions: int: questions in the student file\n-truth_questions: int: questions in the ground truth\n-matched_questions: int: ids present in both files\n-skipped_student_ids: int: student ids not in truth\n-unanswered_truth_ids: int: truth ids with no student result\n-evaluated_questions: int: questions used in the mean\n-k_requested: List[int]\n-k_above_stored: List[int]: warning only, still computed\n-recall_at_k: Dict[int, float]: k -> mean recall (empty if invalid)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-student_valid: bool: result of validate_student\n-validation_errors: List[str]: why the student file is invalid\n-student_questions: int: questions in the student file\n-truth_questions: int: questions in the ground truth\n-matched_questions: int: ids present in both files\n-skipped_student_ids: int: student ids not in truth\n-unanswered_truth_ids: int: truth ids with no student result\n-evaluated_questions: int: questions used in the mean\n-k_requested: List[int]\n-k_above_stored: List[int]: warning only, still computed\n-recall_at_k: Dict[int, float]: k -> mean recall (empty if invalid)",
      "autoResize": true,
      "lineHeight": 1.25
    },
