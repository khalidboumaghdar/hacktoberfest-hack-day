    {
      "id": "7MSpkrySA4dcx-wMGHmbD",
      "type": "text",
      "x": 9402.898460694178,
      "y": 5214.693446738646,
      "width": 643.3309326171875,
      "height": 183.90562905856552,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
