      "type": "text",
      "x": 10212.898369141443,
      "y": 5841.808925254271,
      "width": 512.7210693359375,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
