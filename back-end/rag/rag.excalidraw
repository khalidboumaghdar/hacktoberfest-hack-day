      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Turns two validated datasets into an EvaluationReport.\nOwns the metric structure: validity, pairing, slicing to k, averaging.\nDelegates every match decision to SourceMatcher.",
      "autoResize": true,
      "lineHeight": 1.25
    },
