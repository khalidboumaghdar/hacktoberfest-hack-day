    {
      "id": "qzMs4VOG9FX3LPcTxLU0G",
      "type": "text",
      "x": -2828.9254233647953,
      "y": -2213.57225194265,
      "width": 727.8739013671875,
      "height": 247.80725598186905,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
