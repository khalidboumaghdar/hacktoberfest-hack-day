    {
      "id": "r_9vrbdmeOArA3lewijSA",
      "type": "text",
      "x": 7760.770949288017,
      "y": 6690.405970001603,
      "width": 515.1530151367188,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9k",
      "roundness": null,
      "seed": 1238969544,
      "version": 346,
      "versionNonce": 1026745272,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791648748868,
      "link": null,
      "locked": false,
      "text": "Turns two validated datasets into an EvaluationReport.\nOwns the metric structure: validity, pairing, slicing to k, averaging.\nDelegates every match decision to SourceMatcher.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Turns two validated datasets into an EvaluationReport.\nOwns the metric structure: validity, pairing, slicing to k, averaging.\nDelegates every match decision to SourceMatcher.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
