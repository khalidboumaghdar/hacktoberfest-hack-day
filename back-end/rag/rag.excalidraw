      "isDeleted": false,
      "boundElements": [],
      "updated": 1791558050806,
      "link": null,
      "locked": false,
      "text": "Fire parses the command line and calls search or search_dataset.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fire parses the command line and calls search or search_dataset.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6wvJDZPEavwZsrjbIQqbz",
      "type": "text",
      "x": -9856.710160331124,
      "y": 4860.099418386203,
      "width": 665.159423828125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b43",
      "roundness": null,
      "seed": 1275893400,
      "version": 297,
      "versionNonce": 263546344,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791558050806,
      "link": null,
      "locked": false,
      "text": "Fire guesses types. A query like 42 or True reaches your function\nas an int or bool, not a string. Convert the query to str at the\ntop of search and validate it. An empty or whitespace-only query\nand k <= 0 should be rejected here with a clear message, before any\nexpensive work.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fire guesses types. A query like 42 or True reaches your function as an int or bool, not a string. Convert the query to str at the top of search and validate it. An empty or whitespace-only query and k <= 0 should be rejected here with a clear message, before any expensive work.",
      "autoResize": false,
      "lineHeight": 1.25
    },
