      "updated": 1791558050806,
      "link": null,
      "locked": false,
      "text": "Outside the bm25 class, zip each question's ID and text with\nits sources into MinimalSearchResults, then wrap the list in\nStudentSearchResults. For the k field, use the requested k. The\nsubject defines it as \"number of results requested\", so don't\nstore the clamped value.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Outside the bm25 class, zip each question's ID and text with its sources into MinimalSearchResults, then wrap the list in StudentSearchResults. For the k field, use the requested k. The subject defines it as \"number of results requested\", so don't store the clamped value.",
      "autoResize": false,
      "lineHeight": 1.25
    },
